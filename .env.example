# ==============================================================================
# SkillCheckr Environment Variables Configuration Template
# Copy this file to .env and configure your local environment values
# ==============================================================================

# Application & Server Port
APP_NAME=SkillCheckr-Backend
SERVER_PORT=8080

# MySQL Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_application_system
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/exam_application_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Google OAuth2 Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HikariCP Connection Pool (Optional)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1800000
DB_POOL_CONN_TIMEOUT=30000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:5173
