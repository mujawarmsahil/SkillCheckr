# ==============================================================================
# SkillCheckr Backend Environment Variables Template
#
# This is the only backend env template in the repository. Copy it next to the
# backend module and fill in real values:
#
#   cp backend/.env.example backend/.env
#
# `.env` is git-ignored and must never be committed; this template is safe to
# commit because it carries no credentials.
#
# Spring Boot does not read `.env` by itself. Either export the values before
# starting the backend:
#
#   set -a; source backend/.env; set +a; npm run dev:backend
#
# or set the same variables in your deployment platform (Render, Docker, etc.).
# The frontend has its own template, frontend/.env.example, for the public
# VITE_API_URL value; that variable must never appear here.
# ==============================================================================

# Application & Server Port
APP_NAME=SkillCheckr-Backend
PORT=8080
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# MySQL Database Settings (Use DB_URL or individual host/port/name parameters)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_application_system
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_SSL=false
# Full JDBC URL example (recommended for Render with cloud MySQL providers such as Aiven/TiDB):
# DB_URL=jdbc:mysql://<hostname>:<port>/<database>?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/exam_application_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://skill-checkr.vercel.app,http://localhost:5173,http://localhost:3000
# Only needed when the frontend is served from a single origin. Leave unset otherwise.
# CORS_ALLOW_CREDENTIALS=true

# Active Spring profile. `dev` keeps local conveniences (loopback CORS origins and the
# development token secret). Any other value, including leaving this unset, is treated as
# a real deployment and REQUIRES a real TOKEN_SECRET below.
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# Token Signing Secret  (REQUIRED outside the `dev` profile)
# ==============================================================================
# Anyone holding this value can mint valid tokens for any user and role, so it must be
# private, never committed, and different per environment. Minimum 32 characters;
# the backend refuses to start when it is missing, too short, or still set to the
# committed development fallback.
#
# Generate one with:  openssl rand -base64 48
#
# Leave this unset to use the local development fallback. The backend will then generate a
# random secret per run, so every token stops working after a restart.
# TOKEN_SECRET=

# HikariCP Connection Pool (Optional tuning)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1800000
DB_POOL_CONN_TIMEOUT=30000
