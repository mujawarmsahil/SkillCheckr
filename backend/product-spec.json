{
  "product": {
    "name": "SkillCheckr",
    "version": "2.0.0",
    "description": "Next-Generation Academic Examination and Dual-Engine Skill Assessment Platform (MCQ & Descriptive Question-Answer)",
    "type": "Fullstack Application",
    "architecture": {
      "backend": "Spring Boot 3.4.4 (Java 21)",
      "frontend": "React 19 (Vite, TailwindCSS, React Router v7, Recharts)",
      "database": "MySQL 8.x"
    }
  },
  "scripts": {
    "backend:dev": "SPRING_PROFILES_ACTIVE=dev ./mvnw spring-boot:run",
    "backend:build": "./mvnw clean package -DskipTests",
    "backend:compile": "./mvnw clean compile",
    "backend:test": "./mvnw test",
    "backend:lint": "./mvnw checkstyle:check",
    "frontend:dev": "npm run dev --prefix ../frontend",
    "frontend:build": "npm run build --prefix ../frontend",
    "frontend:lint": "npm run lint --prefix ../frontend",
    "frontend:lint:fix": "npm run lint --prefix ../frontend -- --fix",
    "all:lint": "npm run lint --prefix ../frontend && ./mvnw checkstyle:check test-compile",
    "all:build": "npm run build --prefix ../frontend && ./mvnw clean package -DskipTests",
    "pre-commit:check": "npm run lint --prefix ../frontend && ./mvnw checkstyle:check test-compile"
  },
  "modules": {
    "authentication": {
      "roles": ["Admin", "Teacher", "Student"],
      "endpoints": {
        "login": "POST /api/auth/login",
        "register": "POST /api/requests"
      }
    },
    "examination_engine": {
      "formats": {
        "MCQ": {
          "description": "Multiple Choice Questions with 4 options and automated instant scoring.",
          "grading": "Instant automated scorecard generation with answer-key analysis."
        },
        "QUESTION_ANSWER": {
          "description": "Theory/Subjective questions with reference rubric, word counters, and autosave draft.",
          "grading": "Model rubric comparison and teacher evaluation workflow."
        }
      },
      "endpoints": {
        "create_exam": "POST /api/exams",
        "add_questions": "POST /api/questions",
        "get_questions": "GET /api/exams/{id}/questions",
        "submit_exam": "POST /api/exams/{exam_id}/attempts/{attempt_id}/submit",
        "get_student_results": "GET /api/results/student/{studentId}"
      }
    },
    "admin_console": {
      "features": [
        "Review and approve pending registration requests for teachers and students",
        "Manage active user rosters and credentials",
        "Approve teacher-submitted exams for student discovery",
        "Monitor aggregate platform distribution statistics"
      ],
      "endpoints": {
        "pending_requests": "GET /api/requests",
        "approve_teacher": "POST /api/admin/teachers/from-request/{requestId}",
        "approve_student": "POST /api/admin/students/from-request/{requestId}",
        "delete_request": "DELETE /api/requests/{requestId}",
        "all_teachers": "GET /api/admin/teachers",
        "all_students": "GET /api/admin/students",
        "approve_exam": "POST /api/exams/{examId}/approve",
        "stats": "GET /api/admin/stats"
      }
    }
  },
  "database": {
    "name": "exam_application_system",
    "schema_file": "src/main/resources/schema.sql",
    "tables": [
      "user",
      "student",
      "teacher",
      "admin",
      "subject",
      "request",
      "exam",
      "question",
      "answer",
      "exam_question",
      "exam_registration",
      "exam_attempt",
      "attempt_answer",
      "result"
    ]
  },
  "code_quality": {
    "frontend_linter": "eslint (v9.x)",
    "backend_linter": "maven-checkstyle-plugin (v3.4.0)",
    "git_hooks": {
      "pre-commit": "Enforces frontend ESLint check and backend checkstyle/compilation before any commit"
    }
  }
}
